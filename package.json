{
  "name": "vite-vesttor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "migration:financeiro": "node scripts/migrar-financeiro.js",
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "emulators": "npx -y firebase-tools@latest emulators:start --only auth,firestore --project demo-vesttor",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run --exclude firestore.rules.test.js",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --config firebase.test.json --only firestore --project demo-vesttor-rules \"vitest run firestore.rules.test.js\"",
    "deploy:hosting": "npm run build && npx -y firebase-tools@latest deploy --only hosting",
    "deploy:rules": "npx -y firebase-tools@latest deploy --only firestore:rules",
    "deploy:indexes": "npx -y firebase-tools@latest deploy --only firestore:indexes"
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.17.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^13.10.0",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  }
}
