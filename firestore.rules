rules_version = '2';

// Assumed data model:
// transacoes/{transactionId}
// - userId: string, required and immutable
// - data: timestamp, required
// - descricao: string, required, 1-100 characters
// - valor: number, required and positive
// - tipo: "receita" or "despesa", required
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return isOwner(request.resource.data.userId);
    }

    function uidNotModified() {
      return request.resource.data.userId == resource.data.userId;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll([
          'userId',
          'data',
          'descricao',
          'valor',
          'tipo'
        ])
        && data.keys().hasOnly([
          'userId',
          'data',
          'descricao',
          'valor',
          'tipo'
        ])
        && data.userId is string
        && data.userId.size() > 0
        && data.userId.size() <= 128
        && data.data is timestamp
        && data.descricao is string
        && data.descricao.size() > 0
        && data.descricao.size() <= 100
        && data.valor is number
        && data.valor > 0
        && data.tipo in ['receita', 'despesa'];
    }

    match /transacoes/{transactionId} {
      allow read: if isOwner(resource.data.userId);

      allow create: if uidUnchanged()
        && isValidTransaction(request.resource.data);

      allow update: if isOwner(resource.data.userId)
        && uidNotModified()
        && isValidTransaction(request.resource.data);

      allow delete: if isOwner(resource.data.userId);
    }
  }
}
