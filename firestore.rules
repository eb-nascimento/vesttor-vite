rules_version = '2';

// Assumed data model:
// transacoes/{transactionId}
// - userId: string, required and immutable
// - data: timestamp, required
// - descricao: string, required, 1-100 characters
// - valor: number, required and positive
// - tipo: "receita" or "despesa", required
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return isOwner(request.resource.data.userId);
    }

    function uidNotModified() {
      return request.resource.data.userId == resource.data.userId;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll([
          'userId',
          'data',
          'descricao',
          'valor',
          'tipo'
        ])
        && data.keys().hasOnly([
          'userId',
          'data',
          'descricao',
          'valor',
          'tipo',
          'categoria',
          'metodoPagamento',
          'parcelado',
          'parcelas',
          'parcelamentoId',
          'numeroParcela',
          'totalParcelas',
          'valorTotalCompra'
        ])
        && data.userId is string
        && data.userId.size() > 0
        && data.userId.size() <= 128
        && data.data is timestamp
        && data.descricao is string
        && data.descricao.size() > 0
        && data.descricao.size() <= 100
        && data.valor is number
        && data.valor > 0
        && data.tipo in ['receita', 'despesa']
        && (!('categoria' in data) || (data.categoria is string && data.categoria.size() <= 50))
        && (!('metodoPagamento' in data) || (data.metodoPagamento is string && data.metodoPagamento.size() <= 50))
        && (!('parcelado' in data) || data.parcelado is bool)
        && (!('parcelas' in data) || (data.parcelas is number && data.parcelas >= 1 && data.parcelas <= 72))
        && (!('parcelamentoId' in data) || (data.parcelamentoId is string && data.parcelamentoId.size() <= 100))
        && (!('numeroParcela' in data) || (data.numeroParcela is number && data.numeroParcela >= 1 && data.numeroParcela <= 72))
        && (!('totalParcelas' in data) || (data.totalParcelas is number && data.totalParcelas >= 2 && data.totalParcelas <= 72))
        && (!('valorTotalCompra' in data) || (data.valorTotalCompra is number && data.valorTotalCompra > 0));
    }

    function isValidPlanning(data) {
      return data.keys().hasAll([
          'userId',
          'categoria',
          'tipo',
          'planejado',
          'mesAno',
          'dataCriacao'
        ])
        && data.keys().hasOnly([
          'userId',
          'categoria',
          'tipo',
          'planejado',
          'mesAno',
          'dataCriacao'
        ])
        && data.userId is string
        && data.userId.size() > 0
        && data.userId.size() <= 128
        && data.categoria is string
        && data.categoria.size() > 0
        && data.categoria.size() <= 50
        && data.tipo in ['Entrada', 'Fixo', 'Variável']
        && data.planejado is number
        && data.planejado >= 0
        && data.mesAno is string
        && data.mesAno.matches('^\\d{4}-(0[1-9]|1[0-2])$')
        && (data.dataCriacao is timestamp
          || (data.dataCriacao is string
            && data.dataCriacao.size() > 0
            && data.dataCriacao.size() <= 40));
    }

    match /transacoes/{transactionId} {
      allow read: if isOwner(resource.data.userId);

      allow create: if uidUnchanged()
        && isValidTransaction(request.resource.data);

      allow update: if isOwner(resource.data.userId)
        && uidNotModified()
        && isValidTransaction(request.resource.data);

      allow delete: if isOwner(resource.data.userId);
    }

    match /planejamentos/{planningId} {
      allow read: if isOwner(resource.data.userId);

      allow create: if uidUnchanged()
        && isValidPlanning(request.resource.data);

      allow update: if isOwner(resource.data.userId)
        && uidNotModified()
        && isValidPlanning(request.resource.data);

      allow delete: if isOwner(resource.data.userId);
    }
  }
}
